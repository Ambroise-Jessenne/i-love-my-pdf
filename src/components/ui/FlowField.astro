---
// Decorative animated background, fixed behind every page.
---

<canvas class="flow-field" aria-hidden="true"></canvas>

<script>
  import { startFlowField } from './flowField';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.flow-field');
  if (canvas) startFlowField(canvas);
</script>

<style>
  .flow-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    view-transition-name: flow-field;
  }
</style>
